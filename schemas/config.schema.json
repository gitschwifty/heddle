{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HeddleConfigSchema",
  "type": "object",
  "properties": {
    "api_key": {
      "description": "Legacy plaintext credential. Prefer the default Keychain item or an override.",
      "type": [
        "string",
        "null"
      ]
    },
    "app_attribution": {
      "anyOf": [
        {
          "$ref": "#/definitions/AppAttributionSchema"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval_mode": {
      "anyOf": [
        {
          "$ref": "#/definitions/ApprovalModeWire"
        },
        {
          "type": "null"
        }
      ]
    },
    "base_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "budget_limit": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "compact_buffer": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "compact_trigger": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "doom_loop_threshold": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "editor_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "features": {
      "anyOf": [
        {
          "$ref": "#/definitions/FeaturesSchema"
        },
        {
          "type": "null"
        }
      ]
    },
    "hooks": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/HookDefinition"
        }
      }
    },
    "instructions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "max_tokens": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "openrouter_routing": {
      "anyOf": [
        {
          "$ref": "#/definitions/OpenRouterRoutingModeWire"
        },
        {
          "type": "null"
        }
      ]
    },
    "permissions": {
      "anyOf": [
        {
          "$ref": "#/definitions/PermissionsConfigSchema"
        },
        {
          "type": "null"
        }
      ]
    },
    "providers": {
      "description": "Deprecated compatibility alias for `routers`.",
      "anyOf": [
        {
          "$ref": "#/definitions/RoutersConfigSchema"
        },
        {
          "type": "null"
        }
      ]
    },
    "prune_minimum": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "prune_protect": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "routers": {
      "description": "Request routers such as OpenRouter and Straitly.",
      "anyOf": [
        {
          "$ref": "#/definitions/RoutersConfigSchema"
        },
        {
          "type": "null"
        }
      ]
    },
    "sandbox": {
      "anyOf": [
        {
          "$ref": "#/definitions/SandboxConfigSchema"
        },
        {
          "type": "null"
        }
      ]
    },
    "system_prompt": {
      "type": [
        "string",
        "null"
      ]
    },
    "temperature": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "tools": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "weak_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "web_fetch_allow_private_addresses": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "workspace": {
      "anyOf": [
        {
          "$ref": "#/definitions/WorkspaceConfigSchema"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "AppAttributionSchema": {
      "type": "object",
      "properties": {
        "categories": {
          "type": [
            "string",
            "null"
          ]
        },
        "referer": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ApprovalModeWire": {
      "type": "string",
      "enum": [
        "suggest",
        "auto-edit",
        "full-auto",
        "plan",
        "yolo"
      ]
    },
    "FeaturesSchema": {
      "type": "object",
      "properties": {
        "facets": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "file_history": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "history": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "hooks": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "paste_cache": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "status_line": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tasks": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "usage_data": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "HookDefinition": {
      "description": "Wire-format hook entry from TOML/JSON before defaults are applied.",
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "async": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "command": {
          "type": "string"
        },
        "matchers": {
          "anyOf": [
            {
              "$ref": "#/definitions/HookMatchers"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/definitions/HookMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "HookMatchers": {
      "type": "object",
      "properties": {
        "match_args": {
          "type": [
            "string",
            "null"
          ]
        },
        "match_input": {
          "type": [
            "string",
            "null"
          ]
        },
        "match_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "description": "Either a single tool name or a list of names.",
          "anyOf": [
            {
              "$ref": "#/definitions/ToolMatch"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "HookMode": {
      "type": "string",
      "enum": [
        "interactive",
        "headless",
        "both"
      ]
    },
    "OpenRouterCredentialsSchema": {
      "type": "object",
      "properties": {
        "credential": {
          "description": "Override the default `keychain:heddle/openrouter` non-secret credential reference.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "OpenRouterRoutingModeWire": {
      "type": "string",
      "enum": [
        "balanced",
        "nitro",
        "exacto"
      ]
    },
    "PermissionsConfigSchema": {
      "type": "object",
      "properties": {
        "allow": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "ask": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "RouterKindWire": {
      "type": "string",
      "enum": [
        "open-router",
        "straitly"
      ]
    },
    "RoutersConfigSchema": {
      "type": "object",
      "properties": {
        "active": {
          "anyOf": [
            {
              "$ref": "#/definitions/RouterKindWire"
            },
            {
              "type": "null"
            }
          ]
        },
        "openrouter": {
          "anyOf": [
            {
              "$ref": "#/definitions/OpenRouterCredentialsSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "straitly": {
          "anyOf": [
            {
              "$ref": "#/definitions/StraitlyCredentialsSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SandboxConfigSchema": {
      "type": "object",
      "properties": {
        "deny_paths": {
          "description": "Additional absolute host paths Bash must not read or write.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "profile": {
          "description": "Named Bash sandbox policy. Sessions default to `developer`; evals enforce `strict` regardless of this value.",
          "anyOf": [
            {
              "$ref": "#/definitions/SandboxProfile"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SandboxProfile": {
      "description": "Named, enforced Bash policies. `strict` is the eval/headless baseline; `developer` retains the compatible interactive developer environment.",
      "type": "string",
      "enum": [
        "strict",
        "developer"
      ]
    },
    "StraitlyCredentialsSchema": {
      "type": "object",
      "properties": {
        "credential": {
          "description": "Override the default `keychain:heddle/straitly` non-secret credential reference.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ToolMatch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "WorkspaceConfigSchema": {
      "type": "object",
      "properties": {
        "additional_roots": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
